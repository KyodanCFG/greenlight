# Template only. Copy to .env and fill in real values there.
# This file is committed — it must never contain a real key.

# Meshy API. Server-side only; never expose this to client code.
MESHY_API_KEY=replace_with_your_meshy_api_key

# Optional LLM integration. Whether the product uses one at all is still an open
# question — see docs/OPEN_QUESTIONS.md.
AI_API_URL=
AI_API_KEY=
AI_API_MODEL=
